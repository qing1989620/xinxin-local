[Unit]
Description=Xinxin private Agent API and task worker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=6

[Service]
Type=simple
User=xinxin
Group=xinxin
WorkingDirectory=/var/lib/xinxin
EnvironmentFile=/etc/xinxin/backend.env
ExecStart=/opt/xinxin/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStopSec=35
KillMode=control-group
UMask=0077
StateDirectory=xinxin
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xinxin
CPUQuota=150%
MemoryHigh=1280M
MemoryMax=1536M
TasksMax=128
LimitNOFILE=8192
LogNamespace=xinxin
LogRateLimitIntervalSec=30s
LogRateLimitBurst=300

[Install]
WantedBy=multi-user.target
