XINXIN_DATA_DIR=/var/lib/xinxin
XINXIN_TASK_CONCURRENCY=1
PYTHONPATH=/opt/xinxin/backend
XINXIN_CORS_ORIGINS=https://localhost,http://localhost,capacitor://localhost
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
MPLCONFIGDIR=/var/lib/xinxin/matplotlib
PATH=/opt/xinxin/venv/bin:/usr/local/bin:/usr/bin:/bin
LANG=C.UTF-8
